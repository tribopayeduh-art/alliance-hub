rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false; // Only written via server/admin
    }

    // Affiliates collection
    match /affiliates/{affiliateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Games collection
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // GameStats collection
    match /gameStats/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isSignedIn();
    }

    // GameSessions collection
    match /gameSessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Resultados e configurações são gravados exclusivamente pelo backend.
    match /gameBets/{betId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /gameEvents/{eventId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /gameConfigs/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // AffiliateCommissions collection
    match /affiliateCommissions/{commissionId} {
      allow read: if isSignedIn() && (resource.data.referrerUserId == request.auth.uid);
      allow write: if false; // Only server writes commissions
    }
  }
}
